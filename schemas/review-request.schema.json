{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-ai-governance/review-request.schema.json",
  "title": "Security review request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "request_type",
    "business_purpose",
    "requester",
    "owner",
    "requested_access",
    "expires_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^REV-[0-9]{4}-[0-9]{4}$"
    },
    "request_type": {
      "const": "vendor_network_access"
    },
    "business_purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "requester": {
      "$ref": "#/$defs/person"
    },
    "owner": {
      "$ref": "#/$defs/person"
    },
    "requested_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "services"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "destination": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_ticket": {
      "type": "string"
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}
