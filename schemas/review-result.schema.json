{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-ai-governance/review-result.schema.json",
  "title": "Security review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "request_id",
    "status",
    "evidence",
    "deterministic_findings",
    "assisted_findings",
    "missing_evidence",
    "recommendation",
    "human_decision"
  ],
  "properties": {
    "review_id": {"type": "string"},
    "request_id": {"type": "string"},
    "status": {
      "enum": ["AWAITING_HUMAN_DECISION", "APPROVED", "REJECTED", "REVISION_REQUIRED", "FAILED_SAFE"]
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "deterministic_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "assisted_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "missing_evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendation": {"type": "string"},
    "human_decision": {
      "type": ["object", "null"],
      "properties": {
        "actor": {"type": "string"},
        "decision": {"enum": ["APPROVED", "REJECTED", "REVISION_REQUIRED"]},
        "rationale": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"}
      },
      "required": ["actor", "decision", "rationale", "decided_at"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "source_tool", "sha256", "collected_at"],
      "properties": {
        "id": {"type": "string"},
        "source_tool": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "collected_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "statement", "evidence_ids", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "statement": {"type": "string"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
